FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN node node_modules/prisma/build/index.js generate
RUN node node_modules/typescript/bin/tsc -p packages/validation/tsconfig.json && node node_modules/typescript/bin/tsc -p apps/api/tsconfig.json
ENV BIND_ADDRESS=0.0.0.0
EXPOSE 4000
USER node
CMD ["sh", "-c", "node node_modules/prisma/build/index.js migrate deploy && node apps/api/dist/main.js"]
