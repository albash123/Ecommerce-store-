generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Role {
  id String @id @default(cuid())
  name String @unique
  permissions String[]
  users User[]
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  kind String @default("CUSTOMER")
  verified Boolean @default(false)
  active Boolean @default(true)
  marketingOptIn Boolean @default(false)
  deletionRequestedAt DateTime?
  roleId String?
  role Role? @relation(fields:[roleId], references:[id])
  sessions Session[]
  tokens AuthToken[]
  addresses CustomerAddress[]
  orders Order[]
  reviews Review[]
  wishlists WishlistItem[]
  cart Cart?
  audits AuditLog[]
  notifications Notification[]
  returns ReturnRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([kind,createdAt])
}
model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model AuthToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  kind String
  expiresAt DateTime
  usedAt DateTime?
}
model CustomerAddress {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  phone String
  line1 String
  line2 String @default("")
  city String
  region String @default("")
  postalCode String
  country String
  isDefault Boolean @default(false)
  @@index([userId])
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  image String @default("")
  parentId String?
  parent Category? @relation("categoryTree",fields:[parentId],references:[id])
  children Category[] @relation("categoryTree")
  products Product[]
  seoTitle String @default("")
  seoDescription String @default("")
  position Int @default(0)
  active Boolean @default(true)
}
model Collection {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  image String @default("")
  active Boolean @default(true)
  rules Json?
  products ProductCollection[]
  seoTitle String @default("")
  seoDescription String @default("")
}
model ProductCollection {
  productId String
  collectionId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  @@id([productId,collectionId])
  @@index([collectionId])
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  sku String @unique
  description String @default("")
  shortDescription String @default("")
  price Int
  salePrice Int?
  costPrice Int @default(0)
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  gender String @default("UNISEX")
  tags String[]
  status String @default("DRAFT")
  visibility Boolean @default(true)
  featured Boolean @default(false)
  isNew Boolean @default(false)
  bestSeller Boolean @default(false)
  material String @default("")
  fit String @default("")
  care String @default("")
  modelInfo String @default("")
  shippingInfo String @default("")
  returnInfo String @default("")
  sizeGuide Json?
  attributes Json?
  taxClass String @default("standard")
  video String @default("")
  seoTitle String @default("")
  seoDescription String @default("")
  ogImage String @default("")
  canonicalUrl String @default("")
  noindex Boolean @default(false)
  images ProductImage[]
  variants ProductVariant[]
  collections ProductCollection[]
  campaigns CampaignProduct[]
  reviews Review[]
  wishlists WishlistItem[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,visibility,createdAt])
  @@index([categoryId,gender])
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  url String
  alt String
  position Int @default(0)
  @@index([productId,position])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  sku String @unique
  barcode String @default("")
  color String
  colorHex String @default("#161616")
  size String
  price Int?
  salePrice Int?
  weight Int @default(300)
  image String @default("")
  active Boolean @default(true)
  lowStockThreshold Int @default(5)
  inventory Inventory[]
  transactions InventoryTransaction[]
  cartItems CartItem[]
  orderItems OrderItem[]
  @@unique([productId,color,size])
}
model Warehouse {
  id String @id @default(cuid())
  name String @unique
  inventory Inventory[]
  transactions InventoryTransaction[]
}
model Inventory {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Cascade)
  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  quantity Int @default(0)
  reserved Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([variantId,warehouseId])
}
model InventoryTransaction {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id])
  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  delta Int
  type String
  reason String
  orderId String?
  createdAt DateTime @default(now())
  @@index([variantId,createdAt])
}
model Cart {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  email String @default("")
  items CartItem[]
  updatedAt DateTime @updatedAt
}
model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Cascade)
  quantity Int
  @@unique([cartId,variantId])
}
model WishlistItem {
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([userId,productId])
}
model Order {
  id String @id @default(cuid())
  number String @unique
  userId String?
  user User? @relation(fields:[userId],references:[id])
  email String
  accessTokenHash String
  idempotencyKey String @unique
  requestHash String
  status String @default("PENDING")
  paymentMethod String
  paymentStatus String @default("PENDING")
  subtotal Int
  discount Int
  shipping Int
  tax Int
  total Int
  currency String @default("PKR")
  address Json
  shippingMethodId String
  shippingMethod ShippingMethod @relation(fields:[shippingMethodId],references:[id])
  couponId String?
  coupon Coupon? @relation(fields:[couponId],references:[id])
  trackingNumber String @default("")
  trackingUrl String @default("")
  notes String @default("")
  expiresAt DateTime?
  items OrderItem[]
  history OrderStatusHistory[]
  payments Payment[]
  returns ReturnRequest[]
  refunds Refund[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([email])
  @@index([status,createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  productId String
  product Product @relation(fields:[productId],references:[id])
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id])
  name String
  sku String
  size String
  color String
  image String
  price Int
  quantity Int
  returnItems ReturnItem[]
}
model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  status String
  note String
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  provider String
  providerId String? @unique
  status String @default("PENDING")
  amount Int
  transactions PaymentTransaction[]
  createdAt DateTime @default(now())
}
model PaymentTransaction {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields:[paymentId],references:[id])
  eventId String @unique
  type String
  amount Int
  createdAt DateTime @default(now())
}
model ShippingMethod {
  id String @id @default(cuid())
  name String
  description String @default("")
  price Int
  freeAbove Int?
  countries String[]
  cities String[]
  minWeight Int @default(0)
  maxWeight Int?
  minOrder Int @default(0)
  maxOrder Int?
  cod Boolean @default(true)
  active Boolean @default(true)
  orders Order[]
}
model TaxRule {
  id String @id @default(cuid())
  name String
  country String
  taxClass String @default("standard")
  rate Int
  included Boolean @default(false)
  active Boolean @default(true)
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  name String
  description String @default("")
  type String @default("PERCENTAGE")
  value Int
  minOrder Int @default(0)
  maxDiscount Int?
  startsAt DateTime?
  endsAt DateTime?
  usageLimit Int?
  perCustomerLimit Int @default(1)
  firstOrderOnly Boolean @default(false)
  active Boolean @default(true)
  usedCount Int @default(0)
  productIds String[]
  categoryIds String[]
  collectionIds String[]
  excludedProductIds String[]
  customerEmails String[]
  buyQuantity Int @default(0)
  getQuantity Int @default(0)
  orders Order[]
}
model Discount {
  id String @id @default(cuid())
  name String
  type String @default("PERCENTAGE")
  value Int
  productIds String[]
  categoryIds String[]
  collectionIds String[]
  startsAt DateTime?
  endsAt DateTime?
  active Boolean @default(true)
  campaignId String?
  campaign Campaign? @relation(fields:[campaignId],references:[id])
}
model Campaign {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  headline String
  subtitle String @default("")
  image String @default("")
  mobileImage String @default("")
  themeColor String @default("#d8ff00")
  textColor String @default("#000000")
  ctaText String @default("SHOP THE DROP")
  ctaUrl String @default("/shop")
  status String @default("DRAFT")
  startsAt DateTime
  endsAt DateTime
  seoTitle String @default("")
  seoDescription String @default("")
  products CampaignProduct[]
  sections HomepageSection[]
  discounts Discount[]
  @@index([status,startsAt,endsAt])
}
model CampaignProduct {
  campaignId String
  campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([campaignId,productId])
  @@index([productId])
}
model HomepageSection {
  id String @id @default(cuid())
  type String
  title String @default("")
  subtitle String @default("")
  config Json
  position Int @default(0)
  enabled Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  campaignId String?
  campaign Campaign? @relation(fields:[campaignId],references:[id])
  @@index([enabled,position])
}
model Page {
  id String @id @default(cuid())
  title String
  slug String @unique
  body Json
  status String @default("DRAFT")
  seoTitle String @default("")
  seoDescription String @default("")
  ogImage String @default("")
  noindex Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Menu {
  id String @id @default(cuid())
  name String @unique
  items Json
}
model Media {
  id String @id @default(cuid())
  name String
  url String
  key String @default("")
  alt String @default("")
  mime String
  size Int @default(0)
  thumbnail String @default("")
  createdAt DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  productId String
  product Product @relation(fields:[productId],references:[id])
  rating Int
  title String
  body String
  customerName String
  verified Boolean @default(true)
  status String @default("PENDING")
  reply String @default("")
  images String[]
  createdAt DateTime @default(now())
  @@unique([userId,productId])
  @@index([productId,status,createdAt])
}
model SiteSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id])
  action String
  entity String
  entityId String
  before Json?
  after Json?
  ip String @default("")
  createdAt DateTime @default(now())
  @@index([entity,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id])
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model EmailTemplate {
  id String @id @default(cuid())
  key String @unique
  subject String
  body String
}
model EmailOutbox {
  id String @id @default(cuid())
  to String
  subject String
  body String
  status String @default("PENDING")
  attempts Int @default(0)
  lastError String @default("")
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([status,createdAt])
}
model ReturnRequest {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  reason String
  description String @default("")
  images String[]
  status String @default("REQUESTED")
  note String @default("")
  items ReturnItem[]
  createdAt DateTime @default(now())
}
model ReturnItem {
  id String @id @default(cuid())
  returnId String
  request ReturnRequest @relation(fields:[returnId],references:[id])
  orderItemId String
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  quantity Int
  @@unique([returnId,orderItemId])
}
model Refund {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  amount Int
  reason String
  providerId String?
  status String @default("PENDING")
  createdAt DateTime @default(now())
}
model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique
  source String @default("footer")
  active Boolean @default(true)
  tokenHash String @unique
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}
model Inquiry {
  id String @id @default(cuid())
  name String
  email String
  phone String @default("")
  subject String
  orderNumber String @default("")
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
}
model SearchLog {
  id String @id @default(cuid())
  query String
  resultCount Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}
